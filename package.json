{
  "name": "codex-gesture-dock",
  "private": true,
  "version": "0.6.0",
  "description": "隐私优先的 Windows Codex 手势控制与摄像头辅助系统",
  "author": "silverlion2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/silverlion2/codex-gesture-dock.git"
  },
  "homepage": "https://github.com/silverlion2/codex-gesture-dock",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "assets:prepare": "npm run ocr:assets && npm run vision:assets",
    "ocr:assets": "node scripts/copy-ocr-assets.mjs",
    "vision:assets": "node scripts/copy-vision-assets.mjs",
    "predev": "npm run assets:prepare",
    "predev:desktop": "npm run assets:prepare",
    "prebuild": "npm run assets:prepare",
    "dev": "vite --host 127.0.0.1",
    "dev:desktop": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env ELECTRON_START_URL=http://127.0.0.1:5173 electron .\"",
    "build": "tsc -b && vite build",
    "desktop": "npm run build && electron .",
    "desktop:smoke": "npm run build && electron . --smoke-test",
    "desktop:smoke:tasks": "npm run build && electron . --smoke-test-tasks",
    "desktop:smoke:packaged": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/smoke-packaged.ps1",
    "codex:smoke": "node scripts/smoke-codex-integration.mjs",
    "artifacts:clean": "node scripts/clean-artifacts.mjs",
    "dist:win": "npm run artifacts:clean && npm run build && electron-builder --win --publish never",
    "release:win": "npm run artifacts:clean && npm run build && electron-builder --win --publish never -c.forceCodeSigning=true",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "licenses:generate": "node scripts/third-party-notices.mjs",
    "licenses:check": "node scripts/third-party-notices.mjs --check",
    "sbom:generate": "node scripts/generate-sbom.mjs",
    "install:smoke": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/install-smoke.ps1",
    "preview": "vite preview --host 127.0.0.1",
    "readiness:audit": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/audit-commercial-readiness.ps1",
    "release": "node scripts/release.mjs",
    "version:check": "node scripts/version-check.mjs",
    "release:test": "node --test scripts/tests/*.mjs",
    "test:unit:components": "vitest run src/components --pool=threads --maxWorkers=1",
    "test:unit:lib": "vitest run src/lib --pool=threads --maxWorkers=1",
    "test:unit:app": "vitest run src/hooks src/accessibility.test.tsx --pool=threads --maxWorkers=1",
    "test:unit": "npm run test:unit:components && npm run test:unit:lib && npm run test:unit:app",
    "test:electron": "vitest run electron --pool=threads --maxWorkers=1",
    "test": "npm run test:unit && npm run test:electron && npm run release:test",
    "test:a11y": "playwright test tests/e2e/accessibility.pw.ts",
    "test:a11y:edge": "node scripts/run-edge-a11y.mjs",
    "verify:win-artifacts": "powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/verify-windows-artifacts.ps1",
    "sop:doctor": "web-sop doctor",
    "sop:check": "web-sop check --mode fast",
    "sop:release": "web-sop check --mode release"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.22-rc.20250304",
    "@techstark/opencv-js": "^5.0.0-release.1",
    "@tesseract.js-data/chi_sim": "^1.0.0",
    "@tesseract.js-data/chi_tra": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@zxing/browser": "^0.2.0",
    "colorthief": "^3.3.0",
    "electron-updater": "^6.8.9",
    "exifr": "^7.1.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.468.0",
    "mrz": "5.0.2",
    "pdfjs-dist": "^6.2.108",
    "pixelmatch": "^7.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-image-crop": "^11.1.2",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.61.1",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^6.0.5",
    "axe-core": "^4.12.1",
    "concurrently": "^9.2.4",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.codexgesturedock.desktop",
    "productName": "Codex Gesture Dock",
    "copyright": "Copyright © 2026 silverlion2",
    "compression": "normal",
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "loadBrowserProcessSpecificV8Snapshot": false,
      "grantFileProtocolExtraPrivileges": false
    },
    "asar": true,
    "asarUnpack": [
      "electron/codex-control.ps1",
      "electron/codex-ui-inspect.ps1",
      "electron/codex-window-monitor.ps1",
      "electron/codex-window-policy.ps1",
      "electron/windows-system-control.ps1",
      "electron/windows-pointer-control.ps1",
      "electron/windows-voice-control.ps1"
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "LICENSE",
      "PRIVACY.md",
      "SECURITY.md",
      "THIRD_PARTY_NOTICES.md",
      "docs/code-signing-policy.md",
      "docs/user-guide-zh.md",
      "third_party_licenses/**/*"
    ],
    "directories": {
      "output": "artifacts"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "silverlion2",
        "repo": "codex-gesture-dock"
      }
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "artifactName": "Codex-Gesture-Dock-${version}-setup.${ext}"
    },
    "portable": {
      "artifactName": "Codex-Gesture-Dock-${version}-portable.${ext}"
    }
  }
}
